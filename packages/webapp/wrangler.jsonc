{
   "$schema": "node_modules/wrangler/config-schema.json",
   "name": "caly-cloud-web",
   "main": "src/worker.ts",
   "compatibility_date": "2026-10-01",
   "assets": {
      "directory": "./dist/client",
      "binding": "ASSETS",
      "not_found_handling": "single-page-application",
   },
   "observability": {
      "enabled": true,
   },
}
