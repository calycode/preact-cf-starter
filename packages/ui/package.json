{
   "name": "@caly/ui",
   "version": "0.0.0",
   "private": true,
   "type": "module",
   "exports": {
      "./components/*": "./src/components/*.tsx",
      "./hooks/*": "./src/hooks/*.ts",
      "./lib/*": "./src/lib/*.ts"
   },
   "imports": {
      "#components/*": "./src/components/*.tsx",
      "#hooks/*": "./src/hooks/*.ts",
      "#lib/*": "./src/lib/*.ts"
   },
   "scripts": {
      "check-types": "tsc --noEmit -p tsconfig.json",
      "lint": "eslint src"
   },
   "dependencies": {
      "@base-ui/react": "^1.5.0",
      "class-variance-authority": "^0.7.1",
      "clsx": "^2.1.1",
      "lucide-react": "^1.17.0",
      "tailwind-merge": "^3.6.0"
   },
   "peerDependencies": {
      "preact": "*"
   },
   "devDependencies": {
      "preact": "^10.26.9",
      "typescript": "^6.0.3"
   }
}
